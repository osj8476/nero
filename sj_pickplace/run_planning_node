#!/usr/bin/env bash
# run_planning_node.sh
#
# planning_node 실행 전에 항상 src -> install 로 강제 동기화한 뒤 실행한다.
# "소스는 고쳤는데 실행되는 건 옛날 버전"이 반복됐던 문제를 근본적으로
# 없애기 위한 스크립트. 이 스크립트로만 planning_node를 띄우면 됨.
#
# 사용법:
#   chmod +x run_planning_node.sh
#   ./run_planning_node.sh            # 기본값: use_moveit2:=false (real)
#   ./run_planning_node.sh true       # sim (MoveIt2)
#   ./run_planning_node.sh false      # real (기본값과 동일)

set -e

# ── use_moveit2 인자 처리 ────────────────────────────────────────────────────
USE_MOVEIT2="${1:-false}"
if [[ "$USE_MOVEIT2" != "true" && "$USE_MOVEIT2" != "false" ]]; then
    echo "[error] 첫 번째 인자는 true 또는 false여야 합니다. (입력값: '$USE_MOVEIT2')"
    echo "  사용법: ./run_planning_node.sh [true|false]"
    exit 1
fi

SRC="/home/bpdl/sj/ros2_ws/src/nero/sj_pickplace"
INSTALL_PKG="/home/bpdl/sj/ros2_ws/install/sj_pickplace/lib/python3.12/site-packages/sj_pickplace"

echo "[sync] src -> install 강제 복사..."
cp "$SRC/planning_node.py"   "$INSTALL_PKG/planning_node.py"
cp "$SRC/perception_node.py" "$INSTALL_PKG/perception_node.py"
echo "[sync] 완료."

echo "[check] 반영 확인:"
# 2026-07 real/sim 백엔드 분기 패치 반영 여부 확인용 마커로 교체.
# (예전 "박스각도 반영" 문자열은 이번 패치로 로그 메시지가 바뀌면서
#  더 이상 존재하지 않게 됨 — 그대로 뒀으면 항상 거짓 WARN이 떴을 것)
grep -c "_top_down_quat_for" "$INSTALL_PKG/planning_node.py" || {
    echo "[check][WARN] 새 코드(real/sim 분기 패치)가 반영 안 된 것 같습니다. src 파일 내용을 확인하세요.";
}

source /opt/ros/jazzy/setup.bash
source /home/bpdl/sj/ros2_ws/install/setup.bash
source /home/bpdl/sj/install/setup.bash

export PYTHONPATH="/home/bpdl/sj/ros2_ws/install/sj_pickplace/lib/python3.12/site-packages:/home/bpdl/sj/ros2_ws/install/pymoveit2/lib/python3.13/site-packages:/home/bpdl/sj/install/agx_arm_ctrl/lib/python3.12/site-packages:/home/bpdl/sj/install/agx_arm_msgs/lib/python3.12/site-packages:/opt/ros/jazzy/lib/python3.12/site-packages"

echo "[run] planning_node 시작 (use_moveit2:=$USE_MOVEIT2)"
exec /home/bpdl/sj/ros2_ws/install/sj_pickplace/lib/sj_pickplace/planning_node --ros-args -p use_moveit2:=$USE_MOVEIT2
